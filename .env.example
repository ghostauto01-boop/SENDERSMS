# ============================================================
# SendSMS - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Required ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sendsms
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-encoded-key

# Operator sign-in. The login screen asks for this password (nothing else).
# The app accepts a wrong password nowhere and a missing one never, so change
# this from the shipped default before the app is reachable by anyone else.
# The stored hash follows this value, so rotating it here takes effect on the
# next sign-in — no migration and no re-bootstrapping.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345678
# Legacy alias, only consulted if ADMIN_PASSWORD is empty. Leave it unset.
# LOGIN_PASSWORD=

# Public URL of this deployment, e.g. https://your-app.onrender.com
# REQUIRED for inbound SMS: the app registers this address with SMS-Gate as the
# webhook target. If unset, inbound messages/replies will never arrive.
# It also builds the Brevo webhook URL, the unsubscribe link in bulk mail, and
# every URL in the MCP OAuth metadata.
#
# Leave it empty and the app uses the hostname of each request (proxy-aware), so
# the AI connectors still work from the browser you administrate from. Set it
# explicitly when a client that lives outside your network must reach the app on
# a permanent address - a custom domain, or a phone on a different network:
#   PUBLIC_BASE_URL=https://your-app.onrender.com
# On Render, RENDER_EXTERNAL_URL is used automatically as a fallback.
PUBLIC_BASE_URL=

# --- AI connectors (MCP): ChatGPT / Claude / Arena ---
# OAuth 2.1 is what ChatGPT and Claude custom connectors require. Turning this
# off leaves only static bearer tokens working (Claude Code, curl, and the stdio
# bridge in tools/arena-connector/).
MCP_OAUTH_ENABLED=true
# true  = the connector's authorization page asks for the app password first
#         (the default, because the app itself is password-protected).
# false = it offers a one-tap "continue as the operator" button instead. Only
#         ever set this on a deployment that is not reachable by others.
MCP_OAUTH_REQUIRE_LOGIN=true
MCP_OAUTH_ACCESS_TOKEN_TTL_MINUTES=60
MCP_OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# CORS allowlist for hosted MCP browser clients. Applied only to /mcp,
# /connectors/* and OAuth discovery routes, never to the rest of the CRM API.
# Add provider/inspector origins here if their browser makes direct requests.
MCP_CORS_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai

# --- Inbound email: reading replies out of Gmail ---
# Optional. With these set, Email Manager -> Replies offers "Connect with Google"
# (Gmail API): never-spam filters, labels, and sending through the API.
# Without them, connect the same mailbox with an IMAP app password instead -
# that path needs no Google Cloud project at all.
# Create an OAuth client (Desktop app) at console.cloud.google.com, enable the
# Gmail API, and add <PUBLIC_BASE_URL>/api/v1/mailbox/google/callback as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How often a connected mailbox is checked for replies, in seconds.
GMAIL_POLL_INTERVAL=60
# Move a reply Gmail put in Spam back to the Inbox when it answers mail this app
# sent. This is the fix for "the prospect replied and it landed in my spam".
GMAIL_RESCUE_FROM_SPAM=true
# Send one-to-one replies through the mailbox itself (DMARC-aligned, and they
# appear in Gmail's Sent) instead of Brevo. Campaigns always stay on Brevo.
GMAIL_SEND_REPLIES=true

# --- Email enrichment (all optional — the app works without any of these) ---
# Contacts can be phone-only, email-only, or both, and enrichment fills in what
# is missing. Two of the four stages are free and need no account at all:
#   1. clean    - normalise the address, strip CSV junk          free, offline
#   2. diagnose - MX records, typo fix, disposable/role flags    free, DNS only
#   3. find     - look up a missing address on a company domain  needs Hunter
#   4. verify   - prove the mailbox exists                       needs a verifier
#
# A guessed address (first.last@domain) is stored UNVERIFIED and is excluded
# from sends until somebody confirms it — a bounce costs sender reputation for
# every other email the app sends.
EMAIL_ENRICHMENT_ENABLED=true
# Master switch for the network calls (stages 3-4). With it false, import still
# cleans and diagnoses addresses but nothing is looked up or verified.
EMAIL_ENRICHMENT_USE_PROVIDERS=true
# Pattern guessing. Off by default: the results are unverified by definition.
EMAIL_ENRICHMENT_ALLOW_INFERRED=false
# Add an address found during enrichment as an extra reply alias instead of
# overwriting the primary address already on the contact.
EMAIL_ENRICHMENT_KEEP_PRIMARY=true
# Email a contact whose address was pattern-GUESSED. Off by default: a guess is
# unverified by construction, so it stays visible on the contact (badged
# "Guessed") but is held back from campaigns and direct sends.
EMAIL_SEND_INFERRED=false

# Free tiers, roughly: Hunter ~25 searches + ~50 verifications/month,
# ZeroBounce ~100 credits, NeverBounce ~1000 one-off. Plenty to trial, not
# enough to enrich a 10,000-row list in one click — the UI caps each run and
# says when a quota is exhausted rather than failing silently.
# Get keys at: hunter.io, zerobounce.net, neverbounce.com
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
NEVERBOUNCE_API_KEY=

# --- Optional Application Settings ---
APP_NAME=SMS SENDER
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_TIMEZONE=Africa/Lagos

# Rate limits (slowapi syntax, e.g. "5/minute", "100/hour")
RATE_LIMIT_LOGIN=5/minute

# --- Inline background poller ---
# Set to true ONLY if you are running without a Celery worker. It polls for
# delivery statuses and due scheduled campaigns from inside the web process.
ENABLE_INLINE_POLLER=false
INLINE_POLL_INTERVAL=30
# Idle-aware backoff: after INLINE_POLL_ACTIVE_WINDOW seconds without any
# user/webhook request and nothing due, poll at most every
# INLINE_IDLE_POLL_INTERVAL seconds (or exactly when the next job is due), so
# a Neon free-plan database can scale to zero instead of burning its
# 100 CU-hour monthly quota.
INLINE_IDLE_POLL_INTERVAL=900
INLINE_POLL_ACTIVE_WINDOW=600

# --- SMS Gateway (SMS-Gate.app) - Optional ---
# Set these or configure from Settings page after login
SMSGATE_BASE_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Webhook signing key. Find it on the device at Settings -> Webhooks -> Signing Key.
# Inbound webhooks are rejected with 401 unless their HMAC-SHA256 signature matches.
SMSGATE_WEBHOOK_SECRET=
# Escape hatch for local debugging ONLY. When true, unsigned webhooks are accepted.
# Never enable in production: anyone could inject fake inbound SMS.
SMSGATE_WEBHOOK_ALLOW_UNSIGNED=false
SMSGATE_TIMEOUT=30
SMSGATE_RETRY_COUNT=3
SMSGATE_POLL_INTERVAL=60

# --- OneSignal (Optional) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Pushover (Optional) ---
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# --- Standalone Validator (Contacts / Lists / CSV / single contact) ---
# No API key needed for the built-in syntax, DNS, risk and phone checks.
# SMTP probes require outbound TCP 25, which many managed hosts block. Such
# results are Unknown, NOT proof of a dead mailbox. No messages are sent.
EMAIL_VALIDATOR_SMTP=true
# Optional: complete check_email endpoint for a Reacher instance. Leave blank
# for built-in checks. Hosted Reacher may require its own API key; self-hosted
# instances only need a key if configured to require one. Keep keys server-side.
REACHER_API_URL=
REACHER_API_KEY=
