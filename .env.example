# ============================================================
# SendSMS - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Required ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sendsms
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-encoded-key

# Bootstrap admin credentials (only used on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Public URL of this deployment, e.g. https://your-app.onrender.com
# REQUIRED for inbound SMS: the app registers this address with SMS-Gate as the
# webhook target. If unset, inbound messages/replies will never arrive.
# It also builds the Brevo webhook URL, the unsubscribe link in bulk mail, and
# EVERY URL in the MCP OAuth metadata - without it no AI client (ChatGPT, Claude)
# can complete a connection, because both reject a relative `resource`.
# On Render, RENDER_EXTERNAL_URL is used automatically as a fallback.
PUBLIC_BASE_URL=

# --- AI connectors (MCP): ChatGPT / Claude / Arena ---
# OAuth 2.1 is what ChatGPT and Claude custom connectors require. Turning this
# off leaves only static bearer tokens working (Claude Code, curl, and the stdio
# bridge in tools/arena-connector/).
MCP_OAUTH_ENABLED=true
# false = the consent page offers the app's own one-tap sign-in.
# true  = it asks for the operator password first. Use true on any deployment
#         that people other than you can reach.
MCP_OAUTH_REQUIRE_LOGIN=false
MCP_OAUTH_ACCESS_TOKEN_TTL_MINUTES=60
MCP_OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# --- Inbound email: reading replies out of Gmail ---
# Optional. With these set, Email Manager -> Replies offers "Connect with Google"
# (Gmail API): never-spam filters, labels, and sending through the API.
# Without them, connect the same mailbox with an IMAP app password instead -
# that path needs no Google Cloud project at all.
# Create an OAuth client (Desktop app) at console.cloud.google.com, enable the
# Gmail API, and add <PUBLIC_BASE_URL>/api/v1/mailbox/google/callback as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How often a connected mailbox is checked for replies, in seconds.
GMAIL_POLL_INTERVAL=60
# Move a reply Gmail put in Spam back to the Inbox when it answers mail this app
# sent. This is the fix for "the prospect replied and it landed in my spam".
GMAIL_RESCUE_FROM_SPAM=true
# Send one-to-one replies through the mailbox itself (DMARC-aligned, and they
# appear in Gmail's Sent) instead of Brevo. Campaigns always stay on Brevo.
GMAIL_SEND_REPLIES=true

# --- Optional Application Settings ---
APP_NAME=SMS SENDER
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_TIMEZONE=Africa/Lagos

# Rate limits (slowapi syntax, e.g. "5/minute", "100/hour")
RATE_LIMIT_LOGIN=5/minute

# --- Inline background poller ---
# Set to true ONLY if you are running without a Celery worker. It polls for
# delivery statuses and due scheduled campaigns from inside the web process.
ENABLE_INLINE_POLLER=false
INLINE_POLL_INTERVAL=30
# Idle-aware backoff: after INLINE_POLL_ACTIVE_WINDOW seconds without any
# user/webhook request and nothing due, poll at most every
# INLINE_IDLE_POLL_INTERVAL seconds (or exactly when the next job is due), so
# a Neon free-plan database can scale to zero instead of burning its
# 100 CU-hour monthly quota.
INLINE_IDLE_POLL_INTERVAL=900
INLINE_POLL_ACTIVE_WINDOW=600

# --- SMS Gateway (SMS-Gate.app) - Optional ---
# Set these or configure from Settings page after login
SMSGATE_BASE_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Webhook signing key. Find it on the device at Settings -> Webhooks -> Signing Key.
# Inbound webhooks are rejected with 401 unless their HMAC-SHA256 signature matches.
SMSGATE_WEBHOOK_SECRET=
# Escape hatch for local debugging ONLY. When true, unsigned webhooks are accepted.
# Never enable in production: anyone could inject fake inbound SMS.
SMSGATE_WEBHOOK_ALLOW_UNSIGNED=false
SMSGATE_TIMEOUT=30
SMSGATE_RETRY_COUNT=3
SMSGATE_POLL_INTERVAL=60

# --- OneSignal (Optional) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Pushover (Optional) ---
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
